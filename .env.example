# Environment variables
# tag of the images built from sentinel-rat-pipeline and sentinel-rat-dashboard;
# use another tag for a second stack on the same machine (e.g. a test stack), so
# its builds don't replace the images of this one
IMAGE_TAG=local

POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_pass
POSTGRES_DB=sentinel_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

ML_PIPELINE_PORT=8000
PIPELINE_PORT=8001
WATCH_FOLDER_DOCKER=/data/images
WATCH_FOLDER_HOST=../watched-images
# camera of images directly in the watch folder whose metadata has no device_id
DEFAULT_CAMERA_NAME=hd-zoo-01

DASHBOARD_PORT=8501
DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_pass@db:5432/sentinel_db

# sentinel-rat-pipeline
# new images are collected for this many seconds, then analyzed as one batch
BATCH_WINDOW_SECONDS=60
# larger batches are split into chunks of at most this many images
MAX_BATCH_SIZE=50
# analyze images already in the watch folder at startup
PROCESS_BACKLOG=true
# delete DB rows of removed images even if they were not analyzed yet
FORCE_DELETE_IMAGE_IN_DB=false

# daily analysis (scheduler from sentinel-rat-pipeline, and dashboard)
# a day is aggregated from midnight to midnight in this timezone
ANALYSIS_TZ=Asia/Colombo
# local time (in ANALYSIS_TZ) at which the past days are aggregated every night
ANALYSIS_TIME=00:00
# confidence thresholds for all detection and classification models (0 to 1);
# results below them are left out of the daily analysis, 0 keeps all results
DET_CONF_THRESHOLD=0
CLAS_CONF_THRESHOLD=0
