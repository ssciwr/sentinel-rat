# Environment variables
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_pass
POSTGRES_DB=sentinel_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

ML_PIPELINE_PORT=8000
PIPELINE_PORT=8001
WATCH_FOLDER_DOCKER=/data/images
WATCH_FOLDER_HOST=../watched-images

DASHBOARD_PORT=8501
DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_pass@db:5432/sentinel_db

# sentinel-rat-pipeline
# new images are collected for this many seconds, then analyzed as one batch
BATCH_WINDOW_SECONDS=60
# larger batches are split into chunks of at most this many images
MAX_BATCH_SIZE=50
# analyze images already in the watch folder at startup
PROCESS_BACKLOG=true
# delete DB rows of removed images even if they were not marked as moved
FORCE_DELETE_IMAGE=false
